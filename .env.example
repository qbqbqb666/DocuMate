# 后端启动配置
DOCUMATE_BACKEND_HOST=127.0.0.1
DOCUMATE_BACKEND_PORT=8765
DOCUMATE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,null
DOCUMATE_LOG_LEVEL=info
# 桌面打包版会自动设置这两项，源码开发可以留空。
# DOCUMATE_DATA_DIR=/absolute/path/to/app-data
# DOCUMATE_DEFAULT_WORKSPACE=/absolute/path/to/workspace

# 模型服务（至少配置当前使用的一组）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
