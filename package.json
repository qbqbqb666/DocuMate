{
  "name": "documate",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "src/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:desktop": "concurrently -k -s first \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env DOCUMATE_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "build:backend": "uv run pyinstaller --clean --noconfirm --distpath build/backend --workpath build/pyinstaller documate-backend.spec",
    "build:desktop": "npm run build && npm run build:backend",
    "package:mac": "npm run build:desktop && electron-builder --mac dir",
    "package:win": "npm run build:desktop && electron-builder --win dir",
    "test:electron": "node --test tests-electron/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.documate.app",
    "productName": "DocuMate",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "src/electron/**/*", "package.json"],
    "extraResources": [
      {
        "from": "build/backend/documate-backend",
        "to": "backend/documate-backend"
      }
    ],
    "mac": {
      "target": ["dir"],
      "category": "public.app-category.productivity",
      "icon": "build/icons/macos/documate.icns",
      "identity": null
    },
    "win": {
      "target": ["dir"],
      "icon": "build/icons/windows/documate.ico"
    }
  }
}
